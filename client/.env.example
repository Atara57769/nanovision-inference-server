# Copy to .env.local to override. See src/app/container.ts for defaults.

# Base URL of the NanoVision Inference Server backend.
VITE_API_BASE_URL=http://localhost:8000

# Request timeout for /predict and /health, in milliseconds.
VITE_API_TIMEOUT_MS=30000

# Set to "true" to run the UI against MockPredictionGateway/MockHealthGateway
# instead of the real backend (no server needed).
VITE_USE_MOCK_GATEWAYS=false
